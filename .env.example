# ==============================================================================
# JULY CLOUD INFERENCE - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env for local testing or configure in Render Dashboard
# ==============================================================================

# Server Environment
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000

# Authentication & Access Control
API_KEY=july-hs-secret-key-2026
ADMIN_KEY=july-hs-admin-key-2026
RATE_LIMIT_RPM=60
MAX_PROMPT_CHARS=32768

# Hugging Face Model Synchronization
MODEL_REPO=Harshan-Seliyan/Gravity_HS
MODEL_FILENAME=Gravity_HS.gguf
MODEL_PATH=/models/Gravity_HS.gguf
MODELS_DIR=/models
HF_TOKEN=hf_your_personal_access_token_here
EXPECTED_SHA256=
EXPECTED_SIZE=

# Inference Engine Tuning (CPU Optimized)
N_THREADS=2
N_CTX=2048
N_BATCH=512
MAX_TOKENS_LIMIT=2048
MOCK_INFERENCE=false

# SQLite Conversation Memory Path
CONVERSATION_DB_PATH=/models/conversations.db
